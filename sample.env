# ── Django ──────────────────────────────────────────────
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# ── WhatsApp / AiSensy ──────────────────────────────────
AISENSY_API_KEY=your-aisensy-jwt-api-key
AISENSY_USERNAME=your-aisensy-registered-email

# ── PostgreSQL / Supabase ────────────────────────────────
# DATABASE_URL is what Django reads. Use the session pooler URL (port 5432).
DATABASE_URL=postgres://your-user:your-password@your-host:5432/your-db?sslmode=require

POSTGRES_DATABASE=your-db-name
POSTGRES_HOST=your-db-host
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_PORT=5432
